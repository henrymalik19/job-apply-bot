{
  "name": "job-search-autopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "owner:set": "node --env-file-if-exists=.env.local --import tsx scripts/set-owner.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "worker:discover": "node --env-file-if-exists=.env.local --import tsx workers/discover.ts",
    "import:companies": "node --env-file-if-exists=.env.local --import tsx scripts/import-companies.ts",
    "db:types": "supabase gen types typescript --local --schema public > server/db/database.types.ts",
    "apply:filters": "node --env-file-if-exists=.env.local --import tsx scripts/apply-search-filters.ts",
    "worker:pipeline": "node --env-file-if-exists=.env.local --import tsx workers/pipeline.ts",
    "worker:prepare": "node --env-file-if-exists=.env.local --import tsx workers/prepare.ts",
    "worker:notify": "node --env-file-if-exists=.env.local --import tsx workers/notify.ts",
    "worker:match": "node --env-file-if-exists=.env.local --import tsx workers/match.ts",
    "import:profile": "node --env-file-if-exists=.env.local --import tsx scripts/import-profile.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@base-ui/react": "^1.9.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.2",
    "nodemailer": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  }
}
