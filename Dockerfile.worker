# Worker image for Railway cron services (settings live on the Railway service;
# see README). Runs one worker and exits; Railway starts it on the next tick.
FROM node:24-slim

WORKDIR /app
RUN npm install -g pnpm@10.34.7

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY shared ./shared
COPY server ./server
COPY workers ./workers

CMD ["pnpm", "worker:pipeline"]
