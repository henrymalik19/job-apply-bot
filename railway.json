{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": ["lib/**", "workers/**", "package.json", "pnpm-lock.yaml", "Dockerfile.worker", "railway.json"]
  },
  "deploy": {
    "startCommand": "pnpm worker:discover",
    "cronSchedule": "*/30 * * * *",
    "restartPolicyType": "NEVER"
  }
}
