# Copy to .env.local for local dev. Set the same names in Vercel and GitHub Actions secrets.
# Never commit real values.

# Supabase project API URL. Local: http://127.0.0.1:54321 (see `pnpm exec supabase status`).
SUPABASE_URL=
# Supabase anon (public) key. Used server-side with the user's session; RLS applies.
SUPABASE_ANON_KEY=
# Supabase service role key. Bypasses RLS. Server and workers only; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Auth user id (uuid) of the single admin. After creating the account, run `pnpm owner:set`.
OWNER_USER_ID=
# Optional: a Railway project token for production; Health > Run now starts a worker with it.
RAILWAY_TOKEN=

# Anthropic API key for scoring and tailoring (used from M4).
ANTHROPIC_API_KEY=

# Local dev only, written by `pnpm setup:local` (test owner for the local Supabase stack).
LOCAL_OWNER_EMAIL=
LOCAL_OWNER_PASSWORD=

# Password (or app password) of the job inbox in settings.job_inbox (Purelymail).
# The notify worker sends from it over SMTP; the apply runner reads emailed security codes
# from it over IMAP (and M6 will read replies). Unquoted is fine.
JOB_INBOX_PASSWORD=
# Apply runner only, optional: a different IMAP host/port/address for the security codes
# (default imap.purelymail.com:993 and the job_inbox address).
APPLY_IMAP_HOST=
APPLY_IMAP_PORT=
APPLY_IMAP_USER=

# Resend API key. When set, notify sends through Resend's HTTPS API instead of SMTP
# (Railway Hobby blocks outbound SMTP). The job inbox's domain must be verified in Resend.
RESEND_API_KEY=
